# Optional settings for docker compose. Copy this file to .env (next to docker-compose.yaml); it's gitignored.
# The board's own settings are in server/.env (see server/.env.example).

# Use the dev setup: the site runs on React's dev server and reloads as you edit ./frontend.
# COMPOSE_FILE=docker-compose.yaml:docker-compose.dev.yaml

# Port the site is served on (default 3000). Set SERVER.PUBLIC_URL in server/.env to match.
# WEB_PORT=3000
