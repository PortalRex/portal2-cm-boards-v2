DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/p2boards
SERVER.HOST=127.0.0.1
SERVER.PORT=8080
PROOF.RESULTS=500
PROOF.DEMO=200
PROOF.VIDEO=200
STEAM.API_KEY=EXAMPLE
BACKBLAZE.KEYID=EXAMPLE
BACKBLAZE.KEY=EXAMPLE
BACKBLAZE.BUCKET=EXAMPLE
# Address of the site (API under /api); Steam sign-in returns here.
SERVER.PUBLIC_URL=http://localhost:3000
# Set to true when a reverse proxy (nginx, Caddy, Cloudflare) sits in front, so client addresses
# for rate limits come from X-Forwarded-For. Bind SERVER.HOST to 127.0.0.1 in that case.
# SERVER.BEHIND_PROXY=true
# Shared with /backend (its SERVICE_TOKEN); required by write endpoints for the services.
SERVICE.TOKEN=
# Run submissions: the demo parser script (run with node; `npm install` in server/demo-parser first)
# and the directory submitted demos are saved in. DEMO.NODE overrides the node executable.
DEMO.PARSER=./demo-parser/parse_demo.mjs
DEMO.STORAGE=./demos
# Folders with the old boards' demo files (separated by ;), for downloading imported runs' demos.
# DEMO.ARCHIVE=/srv/demos/p2;/srv/demos/mel
# Co-op ranking: run (default, one rank per run: 1, 2, 3) or player (one rank per player: 1, 1, 3).
# RANKS.COOP=run
# Pull new Portal 2 times from Steam's leaderboards every SYNC.MINUTES (off unless set), for players
# in a map's top SYNC.RANK_LIMIT on Steam.
# SYNC.STEAM=true
# SYNC.MINUTES=10
# SYNC.RANK_LIMIT=500
# Until the old boards are retired, pull from them (Mel runs, demos, videos, comments, bans) at these hours.
# SYNC.OLD_BOARDS=true
# SYNC.OLD_BOARDS_HOURS=0,12
# SYNC.OLD_BOARDS_TZ=America/Chicago
# SYNC.OLD_BOARDS_DAYS=3
# SYNC.PORTAL2_BOARD_URL=https://board.portal2.sr
# SYNC.MEL_BOARD_URL=https://mel.portal2.sr
# From this UTC time (set it to the launch), new top-200 co-op runs need a demo from each player.
# RANKS.COOP_PROOF_SINCE=2026-11-01 00:00:00
RUST_LOG=1
RUST_LOG="actix_web=info"
# Read every demo in the background (portal counts, split times, co-op partners and hosts, SAR version): on
# unless set to false, when DEMO.PARSER is set.
# DEMO.AUTO_PARSE=true
# Threads the demo parser uses (it runs at idle priority on Windows).
# DEMO.PARSE_WORKERS=4
# Staff-only mode while testing before launch: the data needs a signed-in staff account (Steam sign-in
# stays open; everyone else sees a sign-in page).
# SERVER.PRIVATE=true
