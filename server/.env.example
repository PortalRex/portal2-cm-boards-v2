DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/p2boards
SERVER.HOST=127.0.0.1
SERVER.PORT=8080
PROOF.RESULTS=500
PROOF.DEMO=200
PROOF.VIDEO=200
STEAM.API_KEY=EXAMPLE
BACKBLAZE.KEYID=EXAMPLE
BACKBLAZE.KEY=EXAMPLE
BACKBLAZE.BUCKET=EXAMPLE
# Address of the site (API under /api); Steam sign-in returns here.
SERVER.PUBLIC_URL=http://localhost:3000
# Shared with /backend (its SERVICE_TOKEN); required by write endpoints for the services.
SERVICE.TOKEN=
# Run submissions: the demo parser script (run with node; `npm install` in server/demo-parser first)
# and the directory submitted demos are saved in. DEMO.NODE overrides the node executable.
DEMO.PARSER=./demo-parser/parse_demo.mjs
DEMO.STORAGE=./demos
# Folders with the old boards' demo files (separated by ;), for downloading imported runs' demos.
# DEMO.ARCHIVE=/srv/demos/p2;/srv/demos/mel
# Co-op ranking: run (default, one rank per run: 1, 2, 3) or player (one rank per player: 1, 1, 3).
# RANKS.COOP=run
# From this UTC time (set it to the launch), new top-200 co-op runs need a demo from each player.
# RANKS.COOP_PROOF_SINCE=2026-11-01 00:00:00
RUST_LOG=1
RUST_LOG="actix_web=info"
